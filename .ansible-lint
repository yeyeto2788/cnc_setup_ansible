# ansible-lint configuration.
#
# These rules currently fire on main.yaml and are demoted to warnings so CI
# stays green while the findings remain visible in the job log. They are real
# and worth paying down over time:
#   - fqcn                    use ansible.builtin.<module> (e.g. apt)
#   - key-order              order task keys as name, when, block
#   - risky-file-permissions set an explicit `mode:` on file/get_url tasks
#   - jinja                  normalise Jinja spacing: {{ var }} not {{var}}
warn_list:
  - fqcn
  - key-order
  - risky-file-permissions
  - jinja
